{
    "$id": "/questions/definitions.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "question": {
        "if": {
            "properties": { "type": { "const": "Calculated" } }
        },
        "then": { "$ref": "types/calculated.json#/question" },
        "else": {
            "if": {
                "properties": { "type": { "const": "DateRange" } }
            },
            "then": { "$ref": "types/date_range.json#/question" },
            "else": {
                "if": {
                    "properties": { "type": { "const": "General" } }
                },
                "then": { "$ref": "types/general.json#/question" },
                "else": {
                    "if": {
                        "properties": { "type": { "const": "MutuallyExclusive" } }
                    },
                    "then": { "$ref": "types/mutually_exclusive.json#/question" },
                    "else": {
                        "properties": {
                            "type": {
                                "enum": ["Calculated", "DateRange", "General", "MutuallyExclusive"]
                            }
                        },
                        "required": ["type"]
                    }
                }
            }
        }
    },
    "summary": {
        "description": "TextField string concatenations for the summary page",
        "properties": {
            "concatenation_type": {
                "enum": ["Newline", "Space"]
            }
        },
        "maxItems": 1
    }
}

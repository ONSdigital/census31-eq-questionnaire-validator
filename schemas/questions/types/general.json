{
    "$id": "/questions/types/general.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "question": {
        "type": "object",
        "properties": {
            "id": {
                "$ref": "../../common_definitions.json#/identifier"
            },
            "title": {
                "$ref": "../../string_interpolation/definitions.json#/string_with_placeholders"
            },
            "number": {
                "$ref": "../../common_definitions.json#/non_empty_string"
            },
            "description": {
                "$ref": "../../common_definitions.json#/string_array_with_placeholders"
            },
            "instruction": {
                "$ref": "../../common_definitions.json#/string_array_with_placeholders"
            },
            "warning": {
                "$ref": "../../common_definitions.json#/non_empty_string"
            },
            "definitions": {
                "$ref": "../../common_definitions.json#/question_definitions"
            },
            "definition": {
                "$ref": "../../common_definitions.json#/question_definition"
            },
            "guidance": {
                "$ref": "../../common_definitions.json#/guidance"
            },
            "summary": {
                "$ref": "../../questions/definitions.json#/summary"
            },
            "type": {
                "type": "string",
                "const": "General"
            },
            "dynamic_answers": {
                "type": "object",
                "properties": {
                    "values": {
                        "$ref": "../../value_sources.json#/list_value_source"
                    },
                    "answers": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "oneOf": [
                                {
                                    "$ref": "../../answers/currency.json#/answer"
                                },
                                {
                                    "$ref": "../../answers/date.json#/answer"
                                },
                                {
                                    "$ref": "../../answers/month_year_date.json#/answer"
                                },
                                {
                                    "$ref": "../../answers/year_date.json#/answer"
                                },
                                {
                                    "$ref": "../../answers/duration.json#/answer"
                                },
                                {
                                    "$ref": "../../answers/number.json#/answer"
                                },
                                {
                                    "$ref": "../../answers/percentage.json#/answer"
                                },
                                {
                                    "$ref": "../../answers/text_area.json#/answer"
                                },
                                {
                                    "$ref": "../../answers/text_field.json#/answer"
                                },
                                {
                                    "$ref": "../../answers/unit.json#/answer"
                                },
                                {
                                    "$ref": "../../answers/mobile_number.json#/answer"
                                }
                            ]
                        }
                    }
                },
                "additionalProperties": false,
                "required": ["answers", "values"]
            },
            "answers": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "if": {
                        "properties": { "type": { "const": "Address" } }
                    },
                    "then": { "$ref": "../../answers/address.json#/answer" },
                    "else": {
                        "if": {
                            "properties": { "type": { "const": "Checkbox" } }
                        },
                        "then": { "$ref": "../../answers/checkbox.json#/answer" },
                        "else": {
                            "if": {
                                "properties": { "type": { "const": "Currency" } }
                            },
                            "then": { "$ref": "../../answers/currency.json#/answer" },
                            "else": {
                                "if": {
                                    "properties": { "type": { "const": "Date" } }
                                },
                                "then": { "$ref": "../../answers/date.json#/answer" },
                                "else": {
                                    "if": {
                                        "properties": { "type": { "const": "Dropdown" } }
                                    },
                                    "then": { "$ref": "../../answers/dropdown.json#/answer" },
                                    "else": {
                                        "if": {
                                            "properties": { "type": { "const": "Duration" } }
                                        },
                                        "then": { "$ref": "../../answers/duration.json#/answer" },
                                        "else": {
                                            "if": {
                                                "properties": { "type": { "const": "MobileNumber" } }
                                            },
                                            "then": { "$ref": "../../answers/mobile_number.json#/answer" },
                                            "else": {
                                                "if": {
                                                    "properties": { "type": { "const": "MonthYearDate" } }
                                                },
                                                "then": { "$ref": "../../answers/month_year_date.json#/answer" },
                                                "else": {
                                                    "if": {
                                                        "properties": { "type": { "const": "Number" } }
                                                    },
                                                    "then": { "$ref": "../../answers/number.json#/answer" },
                                                    "else": {
                                                        "if": {
                                                            "properties": { "type": { "const": "Percentage" } }
                                                        },
                                                        "then": { "$ref": "../../answers/percentage.json#/answer" },
                                                        "else": {
                                                            "if": {
                                                                "properties": { "type": { "const": "Radio" } }
                                                            },
                                                            "then": { "$ref": "../../answers/radio.json#/answer" },
                                                            "else": {
                                                                "if": {
                                                                    "properties": { "type": { "const": "Relationship" } }
                                                                },
                                                                "then": { "$ref": "../../answers/relationship.json#/answer" },
                                                                "else": {
                                                                    "if": {
                                                                        "properties": { "type": { "const": "TextArea" } }
                                                                    },
                                                                    "then": { "$ref": "../../answers/text_area.json#/answer" },
                                                                    "else": {
                                                                        "if": {
                                                                            "properties": { "type": { "const": "TextField" } }
                                                                        },
                                                                        "then": { "$ref": "../../answers/text_field.json#/answer" },
                                                                        "else": {
                                                                            "if": {
                                                                                "properties": { "type": { "const": "Unit" } }
                                                                            },
                                                                            "then": { "$ref": "../../answers/unit.json#/answer" },
                                                                            "else": {
                                                                                "if": {
                                                                                    "properties": { "type": { "const": "YearDate" } }
                                                                                },
                                                                                "then": { "$ref": "../../answers/year_date.json#/answer" },
                                                                                "else": {
                                                                                    "properties": {
                                                                                        "type": {
                                                                                            "enum": ["Address", "Checkbox", "Currency", "Date", "Dropdown", "Duration", "MobileNumber", "MonthYearDate", "Number", "Percentage", "Radio", "Relationship", "TextArea", "TextField", "Unit", "YearDate"]
                                                                                        }
                                                                                    },
                                                                                    "required": ["type"]
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "if": {
            "not": {
                "required": ["dynamic_answers"]
            }
        },
        "then": {
            "required": ["id", "type", "title", "answers"]
        },
        "else": {
            "required": ["id", "type", "title"]
        },
        "additionalProperties": false
    }
}
